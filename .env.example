# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_CHANNEL_ID=C0XXXXXXXXX

# ── Power BI (preferred data source – no admin/IT approval needed) ────────────
#
# Use your normal Microsoft work-account credentials.
# The agent authenticates via OAuth2 ROPC using Microsoft's pre-registered
# Power BI Desktop client so no AAD app registration is required.
#
# IMPORTANT: If MFA is enforced on your account, generate an App Password at
#   https://mysignins.microsoft.com/security-info
# and paste it as POWERBI_PASSWORD instead of your normal password.
#
POWERBI_USERNAME=your.name@company.com
POWERBI_PASSWORD=YourMicrosoftPassword
#
# Optional overrides (defaults shown):
#POWERBI_TENANT_ID=common               # or your AAD tenant GUID / domain
#POWERBI_WORKSPACE=Sell Analytics       # Power BI workspace name (URL-decoded)
#POWERBI_DATASET=C2B GROWTH - REFERRAL  # Dataset name inside the workspace
#POWERBI_CLIENT_ID=ea0616a9-be27-4c4d-8a57-4becc7cd4f76  # PBI Desktop client
#
# Advanced: override the DAX query entirely (skips auto-discovery)
#POWERBI_DAX_QUERY=EVALUATE 'YourTableName'

# ── Dashboard (fallback web scraper – used when PBI creds are absent) ─────────
DASHBOARD_URL=https://c24-htmlhub.pages.dev/view/nYIhK3cGo_HCzS4AEit6dOFpWK0BisfPCxc9D98DfK4

# ── Scheduling (24 h, IST) ────────────────────────────────────────────────────
SCHEDULE_HOUR=19
SCHEDULE_MINUTE=0
TIMEZONE=Asia/Kolkata

# ── Team filter ───────────────────────────────────────────────────────────────
TL_NAME=Rishabh Malhotra
TM_EMAIL=rishabh.malhotra1@cars24.com

# ── Retry / logging ───────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_DELAY_MS=5000
LOG_LEVEL=info
LOG_FILE=logs/agent.log
